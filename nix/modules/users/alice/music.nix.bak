{ den, inputs, ... }: {
  flake-file.inputs.bitwig-studio = {
    url = "path:/home/alice/Projects/bitwig";
    inputs.nixpkgs.follows = "nixpkgs";
  };
  den.aspects.alice._.music = {
    nixos = { pkgs, ... }: {
    };
    homeManager = { pkgs, ... }: {
      home.packages = with pkgs; [
        (inputs.bitwig-studio.packages.${pkgs.stdenv.hostPlatform.system}.default)
      ];
    };
  };
}
